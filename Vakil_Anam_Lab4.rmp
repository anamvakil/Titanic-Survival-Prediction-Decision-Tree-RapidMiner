      <operator activated="true" class="blending:generate_columns" compatibility="12.0.002" expanded="true" height="82" name="Generate Attributes (3)" width="90" x="916" y="340">
        <list key="function_descriptions">
          <parameter key="Relatives" value="if(SibSp + Parch == 0, &quot;None&quot;, if(SibSp + Parch &lt; 3, &quot;Few&quot;, &quot;Many&quot;))"/>
